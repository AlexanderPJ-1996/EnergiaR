# =========================================================
# .gitignore — Sistema Compra-Venta
# Cubre: .NET Framework 4.8 (WinForms, SisCV 1.00)
#        .NET 10 / Avalonia 12 (SisCV 2.00)
#        Visual Studio Code, Visual Studio, Rider
# =========================================================

# ---------- Visual Studio Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/*.code-workspace
!*.code-workspace
*.vsix

# ---------- .NET / Visual Studio / Rider (build outputs) ----------
bin/
obj/
out/
[Bb]uild/
[Dd]ebug/
[Rr]elease/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
.vs/
.idea/
*.swp
*~

