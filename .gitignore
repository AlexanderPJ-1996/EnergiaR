project.assets.json
project.nuget.cache
project.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets
*.nuget.dgspec.json
*.AssemblyInfoInputs.cache
*.AssemblyInfo.cs
apphost.exe

# ---------- NuGet ----------
packages/
*.nupkg
*.snupkg
*.signature.p7s
.nuget/
TestResult.xml
coverage*.xml
coverage*.json

